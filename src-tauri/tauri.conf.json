{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "纸笺",
  "version": "0.2.1",
  "identifier": "com.lzytaro.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "纸笺 · 随手记录",
        "width": 1320,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "macOS": {
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QjcyOUREOUUyQjhBNTUKUldSVmlpdWUzU20zZEMvUndhTW1UazFHbVZQS0hwRC95OFVNUmdTNUtZUlE1UW9adEw4WjZ2aG8K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
